# Copy to .env.local and fill in. Both are required — the app throws on boot
# without them (see src/lib/supabase.ts). These are PUBLIC client keys; the
# anon/publishable key is safe to ship in the browser because Row Level
# Security scopes every row to the signed-in user.
#
# Find them in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
